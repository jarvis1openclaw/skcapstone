{
  "schema": "sklegal-model-route-registry/v1",
  "registry_purpose": "Pin every model route before any workflow may submit to it. A route pins provider, model name and revision, prompt template id and SHA-256, output schema id and SHA-256, context token budget, timeout, retry class, egress classification ceiling, and admission concurrency.",
  "admission": {
    "behavior": "fail_fast_typed_saturation_error",
    "queueing": "none",
    "slot_release": "on_success_timeout_cancellation_or_error",
    "note": "The fifth concurrent in-flight request for a provider receives a ProviderSaturationError. Callers retry through the pinned Temporal retry class; the gateway never queues."
  },
  "provider_boundary": {
    "qwen_local": "Local Qwen endpoint. Corpus content never leaves the local stack on this route.",
    "openai": "OpenAI Platform API with a secret-store API key and the Responses API with structured outputs. A consumer ChatGPT session or subscription is not an application credential."
  },
  "transport_seam": {
    "purpose": "Deployment-only transport bindings. A route may name a transport profile from config/model_gateway/deployment/transport-profiles.json; switching direct Qwen to SKGateway changes that binding only, never this logical contract.",
    "capacity_domains": "config/model_gateway/deployment/capacity-policy.json",
    "model_catalog": "config/model_gateway/deployment/model-catalog.json"
  },
