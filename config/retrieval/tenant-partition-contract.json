    },
    "retrieval": {
      "service": "sklegal-retrieval-pg",
      "authority": "derived_rebuildable_projection_only",
      "cluster": "separate_dedicated_postgresql_17",
      "initial_backends": [
        "postgresql_full_text_search",
        "pgvector"
      ],
      "graph_backend": {
        "backend": "apache_age",
        "activation": "optional_qualification_gated",
        "unavailable_state": "unavailable_unqualified"
