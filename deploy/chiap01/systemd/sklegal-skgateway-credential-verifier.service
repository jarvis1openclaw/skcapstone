[Unit]
Description=SKLegal metadata-only SKGateway credential verifier
Requires=sklegal-skgateway-credential-verifier.socket
After=sklegal-skgateway-credential-verifier.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=sklegal-credential-verifier
Group=sklegal-credential-verifier
LoadCredentialEncrypted=skgateway-authz-service-token:/etc/credstore.encrypted/skgateway-authz-service-token.cred
Environment=SKLEGAL_CREDENTIAL_METADATA_PATH=/etc/sklegal/skgateway/authz-service-token.metadata.json
ExecStart=/opt/sklegal/.venv/bin/python -m sklegal_api.skgateway_credential_verifier
Restart=on-failure
RestartSec=5
TimeoutStartSec=15
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/sklegal /etc/sklegal/skgateway
StandardOutput=null
StandardError=journal
