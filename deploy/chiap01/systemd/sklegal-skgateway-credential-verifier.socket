[Unit]
Description=SKLegal SKGateway credential verifier socket

[Socket]
ListenStream=/run/sklegal/skgateway-credential-verifier.sock
SocketUser=sklegal-credential-verifier
SocketGroup=sklegal-skgateway
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true
Service=sklegal-skgateway-credential-verifier.service

[Install]
WantedBy=sockets.target
