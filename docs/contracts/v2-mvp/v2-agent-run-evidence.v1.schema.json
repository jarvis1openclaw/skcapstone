{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sklegal:v2-mvp:agent-run-evidence:v1",
  "title": "Durable Agent Run and model evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "matter_id", "agent_run_id", "agent_spec_id", "agent_spec_version", "workflow_id", "run_id", "state", "requested_at", "requested_by_principal_id", "purpose", "matter_snapshot_sha256", "corpus_release", "authority_snapshot", "logical_route_id", "transport_profile_revision", "gateway_revision", "backend", "requested_model_or_bucket", "served_model", "served_model_revision", "prompt_sha256", "schema_sha256", "request_sha256", "response_sha256", "tool_calls", "retrieval_traces", "policy_decision_id", "capability_decision_id", "classification", "source_rights_decision_id", "egress_decision_id", "usage", "latency_ms", "retry_count", "failover_count", "failure"],
  "properties": {
    "tenant_id": {"type": "string", "format": "uuid"},
    "matter_id": {"type": "string", "format": "uuid"},
    "agent_run_id": {"type": "string", "format": "uuid"},
    "agent_spec_id": {"type": "string", "minLength": 1},
    "agent_spec_version": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["requested", "authorized", "running", "succeeded", "failed", "cancelled", "timed_out"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "requested_by_principal_id": {"type": "string", "format": "uuid"},
    "purpose": {"type": "string", "minLength": 1},
    "matter_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_release": {"type": "string", "minLength": 1},
    "authority_snapshot": {"type": ["string", "null"]},
    "logical_route_id": {"type": "string", "minLength": 1},
    "transport_profile_revision": {"type": ["string", "null"]},
    "gateway_revision": {"type": ["string", "null"]},
    "backend": {"type": ["string", "null"]},
    "requested_model_or_bucket": {"type": ["string", "null"]},
    "served_model": {"type": ["string", "null"]},
    "served_model_revision": {"type": ["string", "null"]},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "retrieval_traces": {"type": "array", "items": {"type": "object"}},
    "policy_decision_id": {"type": "string", "format": "uuid"},
    "capability_decision_id": {"type": "string", "format": "uuid"},
    "classification": {"type": "string", "minLength": 1},
    "source_rights_decision_id": {"type": "string", "format": "uuid"},
    "egress_decision_id": {"type": "string", "format": "uuid"},
    "usage": {"type": "object"},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "failover_count": {"type": "integer", "minimum": 0},
    "failure": {"type": ["object", "null"]}
  }
}
