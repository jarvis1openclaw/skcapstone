[Unit]
Description=ATLAS-governed credentialed CMDB network reconcile apply
Documentation=file:%h/clawd/skcapstone-repos/skcoord/docs/cmdb-reconcile-rollout.md
ConditionPathExists=%h/.config/skcapstone/cmdb-network-apply

[Service]
Type=oneshot
# The root-owned/reviewed launcher contains the exact target and skvault mappings.
# It must invoke `skcapstone cmdb reconcile --network --apply --record-run`.
ExecStart=%h/.config/skcapstone/cmdb-network-apply
Nice=10
