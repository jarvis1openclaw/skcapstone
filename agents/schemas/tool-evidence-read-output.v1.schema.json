{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sklegal.tool.evidence-read-output/v1",
  "title": "Evidence read output",
  "description": "One evidence item with its source hash and provenance. Hashes are preserved exactly and never rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_item_ref", "evidence_sha256", "media_type", "content", "provenance"],
  "properties": {
    "evidence_item_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "captured_at"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  }
}
