{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sklegal.tool.deadline-compute-output/v1",
  "title": "Deadline compute output",
  "description": "Deadline candidates from the deterministic calendar. Conflicting or uncertain timing rules are reported, never silently harmonized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "assumptions"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["due_date", "rule_id", "explanation"],
        "properties": {
          "due_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "description": "Timing-rule assumptions and any unresolved contradictions."
    }
  }
}
