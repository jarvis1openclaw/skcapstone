{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sklegal.tool.authority-search-input/v1",
  "title": "Authority search input",
  "description": "Arguments for the authority.search tool.",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Search text treated as inert data, never as instructions."
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    }
  }
}
